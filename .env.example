# Custos server configuration template — copy to .env and fill with real values.
# NEVER commit a filled .env. File forms (*_FILE, mode 0600) are preferred in
# production: env values are visible via /proc/<pid>/environ and docker inspect.

# Required
CUSTOS_DATABASE_URL=postgresql+asyncpg://custos:CHANGE_ME@127.0.0.1:5432/custos
# Keyring: k<n>:<base64url-no-padding-32-bytes>, comma-separated; max version seals.
# Generate one key: openssl rand 32 | basenc --base64url -w0 | tr -d '='
CUSTOS_SECRETS_KEY=
CUSTOS_SECRETS_KEY_FILE=
# Pepper: base64url-no-padding, >=32 random bytes (same generation command).
CUSTOS_PEPPER=
CUSTOS_PEPPER_FILE=

# Bind/TLS contract (see design §3)
CUSTOS_BIND=127.0.0.1
CUSTOS_PORT=8300
# Non-loopback bind requires this (TLS must terminate upstream) + trusted proxies:
CUSTOS_PUBLIC_BIND=
CUSTOS_TRUSTED_PROXIES=
# Plaintext dev mode: loopback only, implies insecure cookies, never with Turnstile.
CUSTOS_INSECURE_DEV=

# Optional
CUSTOS_DATA_DIR=/var/lib/custos
CUSTOS_RETENTION_DAYS=365
CUSTOS_SETUP_CODE=
CUSTOS_OPERATOR_PASSWORD=
CUSTOS_OPERATOR_PASSWORD_FILE=
CUSTOS_TURNSTILE_SECRET=
CUSTOS_TURNSTILE_SITEKEY=
CUSTOS_TURNSTILE_HOSTNAMES=
CUSTOS_WEBAUTHN_RP_ID=
CUSTOS_ALLOWED_ORIGINS=
CUSTOS_ALLOW_MISSING_KEY_VERSION=
CUSTOS_SKIP_MIGRATE=
# Standard OTLP export env (unset = no export):
OTEL_EXPORTER_OTLP_ENDPOINT=