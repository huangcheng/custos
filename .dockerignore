custos-keyring*
custos-pepper*
*.backup
*.sql.bz2
.envrc
.direnv/
.npmrc
*.dump
*.sql
*.sql.gz
secrets/
.superpowers/
.venv/
__pycache__/
*.pyc
.pytest_cache/
.mypy_cache/
.ruff_cache/
tests/
**/__pycache__/
**/*.pyc
docs/
dashboard/
cli/
packages/
.agents/
.claude/
.zcode/
*.local
scripts/node_modules/
*.egg-info/
.coverage
htmlcov/
coverage.xml
dist/
build/
