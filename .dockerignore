# Keep secrets, local state, and non-runtime trees out of the build context.
dev/
.git/
.gitignore
.env
.env.*
**/.env
**/.env.*
**/*.pem
**/*.key
**/*.keyring
**/*.pepper
**/keyring.txt
**/keyring.json
**/pepper.txt
**/custos-keyring*
**/custos-pepper*
*.backup
*.sql.bz2
.envrc
.direnv/
.npmrc
*.dump
*.sql
*.sql.gz
**/secrets/
.superpowers/
.venv/
__pycache__/
*.pyc
.pytest_cache/
.mypy_cache/
.ruff_cache/
tests/
**/__pycache__/
**/*.pyc
docs/
dashboard/
cli/
packages/
# the wrapper ships as its own npm package; the server image never needs it
mcp/
# the CLI is distributed as a release binary and built in its own stage
cli/target/
.agents/
.claude/
.zcode/
**/*.local
scripts/node_modules/
*.egg-info/
.coverage
htmlcov/
coverage.xml
dist/
build/
console/node_modules/
console/dist/
